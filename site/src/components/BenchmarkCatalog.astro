---
import { CATEGORY_HUES, hfUrl, summary } from "../lib/data";
---

<section id="benchmark-catalog" class="border-t border-edge">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="font-mono text-[11px] tracking-[0.28em] text-accent-2">THE GAUNTLET</p>
        <h2 class="mt-2 font-display text-2xl font-semibold tracking-tight sm:text-3xl">Benchmark Catalog</h2>
      </div>
      <p class="font-mono text-xs text-muted">{summary.benchmarks.length} benchmarks · fixed-seed sampling</p>
    </div>

    <div class="reveal mt-8 overflow-hidden rounded-xl border border-edge bg-panel shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full min-w-[820px] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-edge text-[11px] uppercase tracking-wider text-muted bg-panel-2/40">
              <th class="px-4 py-3.5 font-medium">Benchmark</th>
              <th class="px-4 py-3.5 font-medium">Category</th>
              <th class="px-4 py-3.5 text-right font-medium">Full dataset</th>
              <th class="px-4 py-3.5 text-right font-medium">Sampled</th>
              <th class="px-4 py-3.5 font-medium">Verification</th>
              <th class="px-4 py-3.5 font-medium">Source</th>
            </tr>
          </thead>
          <tbody>
            {summary.benchmarks.map((b) => {
              const hue = CATEGORY_HUES[b.category] ?? "var(--muted)";
              const url = hfUrl(b.source);
              return (
                <tr
                  class="border-b border-edge/60 align-top transition-colors last:border-0 hover:bg-panel-2/50 hover:border-l-2 hover:border-l-accent-2"
                  title={`${b.description}${b.paper ? `\n${b.paper}` : ""}`}
                >
                  <td class="px-4 py-3.5 font-medium">{b.display}</td>
                  <td class="px-4 py-3.5">
                    <span
                      class="inline-block rounded-full border px-2.5 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-wider"
                      style={`color:${hue};border-color:color-mix(in srgb, ${hue} 45%, transparent);background:color-mix(in srgb, ${hue} 12%, transparent)`}
                    >
                      {b.category}
                    </span>
                  </td>
                  <td class="px-4 py-3.5 text-right font-mono text-[13px] tabular-nums text-muted">{b.full_dataset}</td>
                  <td class="px-4 py-3.5 text-right font-mono text-[13px] tabular-nums">{b.sampled}</td>
                  <td class="max-w-64 px-4 py-3.5 text-[13px] leading-snug text-muted">{b.verification}</td>
                  <td class="px-4 py-3.5 font-mono text-xs">
                    {url ? (
                      <a href={url} target="_blank" rel="noopener" class="text-accent-2 underline-offset-2 hover:underline">
                        {b.source} ↗
                      </a>
                    ) : (
                      <span class="text-muted">{b.source}</span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
    <p class="mt-3 font-mono text-[11px] text-muted">Hover a row for the benchmark description and citation.</p>
  </div>
</section>

